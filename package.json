{
  "name": "kokoreader",
  "displayName": "Kokoreader",
  "description": "Read open text files aloud with local Kokoro TTS.",
  "icon": "images/openlines.png",
  "repository": { "type": "git", "url": "https://github.com/linellazatin/kokoreader" },
  "license": "MIT",
  "version": "0.2.0",
  "publisher": "openlines",
  "author": "Linel Lazatin",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Machine Learning", "Other"],
  "main": "./extension/extension.js",
  "bin": { "kokoreader": "./bin/kokoreader.js" },
  "scripts": { "test": "node test/cli.js" },
  "contributes": {
    "commands": [
      { "command": "kokoreader.readFile", "title": "Koko Read" },
      { "command": "kokoreader.readFromCursor", "title": "Koko Read From Cursor" },
      { "command": "kokoreader.pause", "title": "Koko Pause" },
      { "command": "kokoreader.resume", "title": "Koko Resume" },
      { "command": "kokoreader.stop", "title": "Koko Stop" },
      { "command": "kokoreader.saveFile", "title": "Koko Save to File" }
    ],
    "menus": {
      "editor/title/context": [
        { "command": "kokoreader.readFile", "group": "navigation@1", "when": "!kokoreader.isPlaying && !kokoreader.isPaused && !kokoreader.isSaving" },
        { "command": "kokoreader.readFromCursor", "group": "navigation@2", "when": "!kokoreader.isPlaying && !kokoreader.isPaused && !kokoreader.isSaving" },
        { "command": "kokoreader.pause", "group": "navigation@3", "when": "kokoreader.isPlaying" },
        { "command": "kokoreader.resume", "group": "navigation@4", "when": "kokoreader.isPaused" },
        { "command": "kokoreader.stop", "group": "navigation@5", "when": "kokoreader.isPlaying || kokoreader.isPaused || kokoreader.isSaving" },
        { "command": "kokoreader.saveFile", "group": "navigation@6", "when": "!kokoreader.isPlaying && !kokoreader.isPaused && !kokoreader.isSaving" }
      ]
    },
    "configuration": {
      "title": "Kokoreader",
      "properties": {
        "kokoreader.modelDir": { "type": "string", "order": 2, "default": "", "description": "Directory containing kokoro-v1.0.onnx and voices-v1.0.bin." },
        "kokoreader.modelPath": { "type": "string", "order": 3, "default": "", "description": "Optional explicit Kokoro ONNX model path." },
        "kokoreader.voicesPath": { "type": "string", "order": 4, "default": "", "description": "Optional explicit Kokoro voice-data path." },
        "kokoreader.modelPrecision": { "type": "string", "order": 5, "enum": ["fp32", "fp16", "int8"], "default": "fp32", "description": "Model asset precision when modelDir is used." },
        "kokoreader.pythonPath": { "type": "string", "order": 1, "default": "", "description": "Python 3.11 or newer interpreter with requirements.txt installed." },
        "kokoreader.voice": { "type": "string", "order": 6, "default": "af_heart", "description": "Kokoro voice. Use a voice matching kokoreader.lang; run kokoreader --list --lang CODE to see installed matches." },
        "kokoreader.lang": { "type": "string", "order": 7, "enum": ["en-us", "en-gb", "es", "fr-fr", "hi", "it", "ja", "pt-br", "cmn"], "enumItemLabels": ["American English", "British English", "Spanish", "French", "Hindi", "Italian", "Japanese", "Brazilian Portuguese", "Mandarin Chinese"], "default": "en-us", "description": "Kokoro-82M voice language. Choose a matching voice; the future voice picker will list only installed matches. For CLI use, --lang remains an unrestricted espeak-ng code." },
        "kokoreader.profile": { "type": "string", "order": 8, "enum": ["narrative", "technical"], "default": "technical", "description": "Technical says ‘The code is’ then reads fenced code blocks with technical-token normalization; narrative announces them instead. Inline code is normalized in both profiles." },
        "kokoreader.speed": { "type": "number", "order": 9, "minimum": 0.5, "maximum": 2, "default": 1, "description": "Kokoro synthesis speed (0.5-2.0). Use tempo for wider playback changes." },
        "kokoreader.tempo": { "type": "number", "order": 10, "default": 1, "description": "Pitch-preserving playback speed." },
        "kokoreader.gain": { "type": "number", "order": 11, "default": -1, "description": "ffmpeg gain in dB." },
        "kokoreader.volume": { "type": "number", "order": 12, "default": 1, "description": "Playback volume multiplier." },
        "kokoreader.format": { "type": "string", "order": 13, "enum": ["wav", "mp3", "flac", "opus"], "default": "wav", "description": "Output format used by Save to File." },
        "kokoreader.sampleRate": { "type": "number", "order": 14, "minimum": 0, "default": 0, "description": "Saved-audio sample rate in Hz. Set 0 to preserve Kokoro's source rate." },
        "kokoreader.normalize": { "type": "boolean", "order": 15, "default": false, "description": "Apply EBU R128 loudness normalization." },
        "kokoreader.limiter": { "type": "boolean", "order": 16, "default": true, "description": "Limit output peaks to prevent clipping." },
        "kokoreader.debug": { "type": "boolean", "order": 17, "default": false, "description": "Show Python worker errors for troubleshooting." }
      }
    }
  }
}
